<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SignalForge.Desktop.ViewModels" xmlns:rt="clr-namespace:RoyalTerminal.Avalonia.Controls;assembly=RoyalTerminal.Avalonia" xmlns:views="using:SignalForge.Desktop.Views" xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls" x:DataType="vm:MainViewModel" x:Class="SignalForge.Desktop.Views.InspectorDockPaneView">
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,0,0">
    <Grid RowDefinitions="42,1,Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="◫" FontSize="14" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="STREAM INSPECTOR" Classes="eyebrow" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Column="1" Background="#19212B" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedTraceRow.Direction}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
        </Border>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource LineBrush}" />
      <StackPanel Grid.Row="2" Margin="12,8" Spacing="6">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel Spacing="3">
            <TextBlock Text="PROTOCOL MODE" Classes="eyebrow" FontSize="8" />
            <ComboBox ItemsSource="{Binding DecoderModes}" SelectedItem="{Binding SelectedDecoderMode}" MinHeight="29" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3" IsVisible="{Binding IsModbusRtuMode}">
            <TextBlock Text="RTU FRAME ROLE" Classes="eyebrow" FontSize="8" />
            <ComboBox ItemsSource="{Binding ModbusRtuRoles}" SelectedItem="{Binding SelectedRtuRole}" MinHeight="29" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding SelectedEventMeta}" FontSize="8" TextWrapping="Wrap" />
        <TextBlock Text="BINARY X-RAY · OFFSET / HEX / ASCII" Classes="eyebrow" FontSize="8" />
        <TextBox Text="{Binding SelectedHexDump}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono" FontSize="8" Height="142" VerticalContentAlignment="Top" Background="#0D1218" BorderBrush="{StaticResource LineBrush}" />
      </StackPanel>
      <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,9">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
          <TextBlock Grid.Row="0" Text="CORE STREAM DECODE" Classes="eyebrow" FontSize="8" />
          <TextBlock Grid.Row="1" Text="{Binding SelectedDecoderStatus}" FontSize="9" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
          <TextBox Grid.Row="2" Text="{Binding SelectedDecoderOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="9" VerticalContentAlignment="Top" Background="#0D1218" BorderBrush="{StaticResource LineBrush}" />
        </Grid>
      </Border>
      <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,7">
        <TextBlock Text="Decoder state is rebuilt by trace sequence and direction. Frames and issues attach only to the event that completes or reports them." FontSize="8" TextWrapping="Wrap" />
      </Border>
    </Grid>
  </Border>
</UserControl>
