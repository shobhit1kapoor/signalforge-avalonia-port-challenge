<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SignalForge.Desktop.ViewModels"
             x:Class="SignalForge.Desktop.Views.BinaryInspectorToolsView"
             x:DataType="vm:BinaryInspectorToolsViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="8" Background="{StaticResource CanvasBrush}">
        <Border Background="#0E131A" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,9">
            <StackPanel Spacing="4">
                <TextBlock Text="BINARY INSPECTOR TOOLS" Classes="eyebrow" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding EventLabel}" FontSize="9" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PayloadSizeText}" FontSize="8" Classes="muted" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#0E131A" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
            <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="9" RowSpacing="9">
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="HEX PATTERN SEARCH" Classes="eyebrow" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding HexPattern}" PlaceholderText="DE AD BE EF" FontFamily="Cascadia Mono" MinHeight="30" />
                            <Button Grid.Column="1" Classes="primary" Content="FIND" Command="{Binding SearchHexCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding SearchResults}" FontSize="9" TextWrapping="Wrap" />
                        <TextBlock Text="Offsets are zero-based and matches do not overlap." FontSize="8" Classes="muted" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="REPLACEMENT PREVIEW" Classes="eyebrow" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <StackPanel Spacing="3">
                                <TextBlock Text="BYTE OFFSET" Classes="eyebrow" FontSize="7" />
                                <TextBox Text="{Binding ReplaceOffset}" MinHeight="29" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="LENGTH TO REPLACE" Classes="eyebrow" FontSize="7" />
                                <TextBox Text="{Binding ReplaceLength}" MinHeight="29" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="REPLACEMENT BYTES · HEX" Classes="eyebrow" FontSize="7" />
                            <TextBox Text="{Binding ReplacementHex}" PlaceholderText="00 FF · empty deletes" FontFamily="Cascadia Mono" MinHeight="29" />
                        </StackPanel>
                        <Button Classes="tool" Content="BUILD PREVIEW" Command="{Binding PreviewReplacementCommand}" HorizontalAlignment="Left" />
                        <TextBox Text="{Binding ReplacementPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="8" Height="92" VerticalContentAlignment="Top" />
                        <TextBlock Text="Preview only; the selected trace event is immutable." FontSize="8" Classes="muted" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="9">
                        <StackPanel Spacing="7">
                            <TextBlock Text="BASE64 CONVERSION" Classes="eyebrow" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding Base64Text}" PlaceholderText="Base64 input or encoded selected payload" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="8" Height="84" VerticalContentAlignment="Top" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="tool" Content="ENCODE SELECTED" Command="{Binding EncodeSelectedBytesCommand}" />
                                <Button Classes="primary" Content="DECODE TO HEX" Command="{Binding DecodeBase64Command}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" />
                        <StackPanel Grid.Column="2" Spacing="7">
                            <TextBlock Text="DECODED BYTE PREVIEW" Classes="eyebrow" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding DecodedHex}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="8" Height="130" VerticalContentAlignment="Top" />
                            <TextBlock Text="Printable ASCII bytes are 0x20–0x7E; control bytes remain visible as hex in the timeline inspector." FontSize="8" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <StackPanel Spacing="7">
                        <TextBlock Text="7-BIT ASCII REFERENCE · HEX AND CONTROL NAMES" Classes="eyebrow" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding AsciiReferenceTable}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono" FontSize="8" Height="178" VerticalContentAlignment="Top" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
